{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/masaraha_admin/**",
              "ui_kits/masaraha_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|signedIn|plain|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: active, onNavigate, signedIn, plain, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:inbox|sent|admin|reports)$/]",
        "message": "<AppHeader> active must be one of 'inbox' | 'sent' | 'admin' | 'reports'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|wordmark|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, tone, wordmark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:citron|rose|light)$/]",
        "message": "<BrandMark> tone must be one of 'citron' | 'rose' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|disabled|as|href|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, disabled, as, href, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|reveal|secondary|ghost|destructive|destructiveSolid)$/]",
        "message": "<Button> variant must be one of 'primary' | 'reveal' | 'secondary' | 'ghost' | 'destructive' | 'destructiveSolid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|bubble|raised|tone|pad|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, bubble, raised, tone, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|citron|rose|inset)$/]",
        "message": "<Card> tone must be one of 'default' | 'citron' | 'rose' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckboxRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|checked|onChange|children|strong|key|ref|className|style|children)$/]",
        "message": "<CheckboxRow> doesn't accept that prop. Declared props: id, checked, onChange, children, strong."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|action|glyph|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, action, glyph, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='glyph'] > Literal[value!=/^(?:bubble|question)$/]",
        "message": "<EmptyState> glyph must be one of 'bubble' | 'question'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HourStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|hour|meridiem|style|key|ref|className|style|children)$/]",
        "message": "<HourStamp> doesn't accept that prop. Declared props: day, hour, meridiem, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HourStamp'] > JSXAttribute[name.name='meridiem'] > Literal[value!=/^(?:ص|م)$/]",
        "message": "<HourStamp> meridiem must be one of 'ص' | 'م'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:origin|slug|enabled|copied|onCopy|onShare|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<LinkBlock> doesn't accept that prop. Declared props: origin, slug, enabled, copied, onCopy, onShare, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:body|day|hour|meridiem|status|offerState|truncate|expanded|onExpand|actions|children|style|key|ref|className|style|children)$/]",
        "message": "<MessageCard> doesn't accept that prop. Declared props: body, day, hour, meridiem, status, offerState, truncate, expanded, onExpand, actions, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageCard'] > JSXAttribute[name.name='meridiem'] > Literal[value!=/^(?:ص|م)$/]",
        "message": "<MessageCard> meridiem must be one of 'ص' | 'م'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:delivered|hidden|reported)$/]",
        "message": "<MessageCard> status must be one of 'delivered' | 'hidden' | 'reported'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageCard'] > JSXAttribute[name.name='offerState'] > Literal[value!=/^(?:pending|resolved|declined|cancelled)$/]",
        "message": "<MessageCard> offerState must be one of 'pending' | 'resolved' | 'declined' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|title|style|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: children, tone, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|citron|rose|warning|danger)$/]",
        "message": "<Notice> tone must be one of 'info' | 'citron' | 'rose' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevealPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|question|stake|senderAnswer|recipientAnswer|senderName|viewpoint|footer|style|key|ref|className|style|children)$/]",
        "message": "<RevealPanel> doesn't accept that prop. Declared props: state, question, stake, senderAnswer, recipientAnswer, senderName, viewpoint, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevealPanel'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|resolved|declined|cancelled)$/]",
        "message": "<RevealPanel> state must be one of 'pending' | 'resolved' | 'declined' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevealPanel'] > JSXAttribute[name.name='viewpoint'] > Literal[value!=/^(?:sender|recipient)$/]",
        "message": "<RevealPanel> viewpoint must be one of 'sender' | 'recipient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|style|key|ref|className|style|children)$/]",
        "message": "<StateChip> doesn't accept that prop. Declared props: state, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:delivered|hidden|reported|pending|resolved|declined|cancelled)$/]",
        "message": "<StateChip> state must be one of 'delivered' | 'hidden' | 'reported' | 'pending' | 'resolved' | 'declined' | 'cancelled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|hint|value|onChange|placeholder|rows|maxLength|counter|hero|error|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: id, label, hint, value, onChange, placeholder, rows, maxLength, counter, hero, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|hint|value|onChange|placeholder|type|maxLength|error|counter|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: id, label, hint, value, onChange, placeholder, type, maxLength, error, counter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password)$/]",
        "message": "<TextField> type must be one of 'text' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|hint|id|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, hint, id."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
